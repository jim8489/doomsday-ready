# Database
POSTGRES_DB=doomsday_ready
POSTGRES_USER=doomsday_user
POSTGRES_PASSWORD=change_this_password
# Host-side port for running Django directly on your Mac.
# Docker Compose overrides this to 5432 inside the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Django
DJANGO_SECRET_KEY=replace_with_a_secure_random_secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend (read by Vite and baked into the frontend Docker image)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
